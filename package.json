{
  "name": "dsh-test-plan-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件：经独立 MCP server 的方案资源按需取数，逐章生成试验方案文档",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./base-plugin/redis-kv-store": {
      "types": "./lib/base_plugin/ext-kv-store/redis_kv_store_provider.d.ts",
      "default": "./lib/base_plugin/ext-kv-store/redis_kv_store_provider.js"
    },
    "./base-plugin/internal-auth": {
      "types": "./lib/base_plugin/internal-auth/internal_auth.d.ts",
      "default": "./lib/base_plugin/internal-auth/internal_auth.js"
    },
    "./base-plugin/tool-filter": {
      "types": "./lib/base_plugin/tool-filter/tool_filter.d.ts",
      "default": "./lib/base_plugin/tool-filter/tool_filter.js"
    },
    "./mcp-server": {
      "types": "./lib/mcp/server.d.ts",
      "default": "./lib/mcp/server.js"
    }
  },
  "files": [
    "lib/",
    "resources/",
    "presets/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc && tsc -p tsconfig.test.json --noEmit && node --experimental-strip-types --test test/*.test.ts",
    "e2e:mcp": "node --experimental-strip-types --test test/mcp-e2e.test.ts",
    "mcp:serve": "node lib/mcp/server.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/test-plan.patch.yml"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@modelcontextprotocol/client": "^2.1.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ioredis": "^6.0.0"
  }
}
