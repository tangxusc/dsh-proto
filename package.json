{
  "name": "dsh-test-plan-tool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 插件：提供 get_test_plan_info 工具，按 planId 获取试验方案信息",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./base-plugin/redis-kv-store": {
      "types": "./lib/base_plugin/ext-kv-store/redis_kv_store_provider.d.ts",
      "default": "./lib/base_plugin/ext-kv-store/redis_kv_store_provider.js"
    },
    "./base-plugin/internal-auth": {
      "types": "./lib/base_plugin/internal-auth/internal_auth.d.ts",
      "default": "./lib/base_plugin/internal-auth/internal_auth.js"
    }
  },
  "files": [
    "lib/",
    "resources/",
    "presets/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc && tsc -p tsconfig.test.json --noEmit && node --experimental-strip-types --test test/*.test.ts",
    "e2e": "node --experimental-strip-types test/e2e.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "ioredis": "^6.0.0"
  }
}
